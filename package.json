{
  "name": "leitor-pdf",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "5.2.0",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@types/jest": "29.5.14",
    "eslint-config-expo": "~57.0.2",
    "expo": "~57.0.22",
    "expo-application": "~57.0.3",
    "expo-build-properties": "~57.0.17",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-keep-awake": "~57.0.2",
    "expo-print": "~57.0.2",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-system-ui": "~57.0.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "pdfjs-dist": "^3.11.174",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-blob-util": "^0.24.11",
    "react-native-pdf": "^7.0.5",
    "react-native-pdf-thumbnail": "^1.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "patch-package && node scripts/copy-pdfjs.js",
    "copy-pdfjs": "node scripts/copy-pdfjs.js",
    "build:apk": "cd android && gradlew assembleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "prebuild:android": "expo prebuild --platform android --clean --no-install && node scripts/copy-pdfjs.js && node scripts/patch-gradle.js",
    "build:apk:emulator": "cd android && gradlew assembleRelease -PreactNativeArchitectures=x86_64",
    "build:aab": "cd android && gradlew bundleRelease -PreactNativeArchitectures=armeabi-v7a,arm64-v8a",
    "bump": "node scripts/bump.js",
    "test": "jest",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint . && jest"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "@react-native-ml-kit/text-recognition",
          "react-native-pdf-thumbnail"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
